{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SwissGov-RSD Semantic Difference IR",
  "type": "object",
  "required": ["differences"],
  "additionalProperties": false,
  "properties": {
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "severity", "confidence"],
        "additionalProperties": false,
        "properties": {
          "source": {"$ref": "#/$defs/nullableSpan"},
          "target": {"$ref": "#/$defs/nullableSpan"},
          "kind": {"enum": ["CHANGE", "ADDITION", "OMISSION", "UNKNOWN"]},
          "severity": {"type": "number", "minimum": 0, "maximum": 5},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "nullableSpan": {"anyOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]}
  }
}
